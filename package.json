{
  "name": "rentashub",
  "private": true,
  "version": "1.0.0-foundation",
  "type": "module",
  "description": "RentasHub is a standalone marketplace to rent, buy, sell, trade, auction, and manage vehicles, equipment, property, spaces, tools, and specialty assets.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/production/*.test.mjs",
    "test:server": "node --test server/tests/*.test.mjs",
    "readiness": "node scripts/check-readiness.mjs",
    "a4:supabase": "node scripts/a4-supabase-tooling.mjs report",
    "a4:validate": "node scripts/a4-supabase-tooling.mjs validate",
    "a4:template": "node scripts/a4-supabase-tooling.mjs template",
    "artifact:validate": "node scripts/validate-release-artifacts.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "security:audit": "node scripts/dependency-audit-wrapper.mjs plan",
    "security:audit:run": "node scripts/dependency-audit-wrapper.mjs run",
    "database:readiness": "node scripts/database-readiness-tooling.mjs report",
    "database:readiness:json": "node scripts/database-readiness-tooling.mjs json",
    "database:migration-template": "node scripts/database-readiness-tooling.mjs migration-template",
    "database:backup-template": "node scripts/database-readiness-tooling.mjs backup-template",
    "rc:tag": "node scripts/release-candidate-tag-helper.mjs",
    "zip:check": "node scripts/check-zip-artifact.mjs",
    "db:check": "node server/src/db/checkConnection.js",
    "db:migrate": "node server/src/db/cli.js migrate",
    "db:seed": "node server/src/db/cli.js seed",
    "db:reset": "node server/src/db/cli.js reset",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.0",
    "typescript": "^5.8.2",
    "vite": "8.0.16"
  }
}
